{
  "info": {
    "name": "CRM Data Cleaner API",
    "description": "Set `apiKey` for authenticated requests. For **Invalid API key**, use a key not listed in `CRM_API_KEYS`. For **Rate limited**, use a **free** tier key and send the same request more than **5 times within 60 seconds** (or exhaust monthly quota). For **Oversized batch**, use a **free** tier key and send **more than 50** records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://crm-data-cleaner.onrender.com" },
    { "key": "apiKey", "value": "sk_free_test" },
    { "key": "freeTierKey", "value": "sk_free_test" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Clean batch (generic)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"default_phone_region\": \"US\",\n  \"export_format\": \"generic\",\n  \"records\": [\n    {\n      \"first_name\": \"Jane\",\n      \"last_name\": \"Doe\",\n      \"email\": \"jane@example.com\",\n      \"phone\": \"+12025550100\",\n      \"company\": \"Acme Inc\"\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/v1/clean"
      }
    },
    {
      "name": "Clean batch — HubSpot export",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"default_phone_region\": \"US\",\n  \"export_format\": \"hubspot\",\n  \"records\": [\n    {\n      \"first_name\": \"Jane\",\n      \"last_name\": \"Doe\",\n      \"email\": \"jane@example.com\",\n      \"phone\": \"(415) 555-2671\",\n      \"company\": \"Acme Inc\",\n      \"title\": \"VP Sales\"\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/v1/clean"
      }
    },
    {
      "name": "Clean batch — Salesforce export",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"default_phone_region\": \"US\",\n  \"export_format\": \"salesforce\",\n  \"records\": [\n    {\n      \"first_name\": \"Jane\",\n      \"last_name\": \"Doe\",\n      \"email\": \"jane@example.com\",\n      \"phone\": \"+12025550100\",\n      \"company\": \"Acme Inc\",\n      \"title\": \"VP Sales\",\n      \"notes\": \"Met at conference\"\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/v1/clean"
      }
    },
    {
      "name": "Clean batch — Zoho export",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"default_phone_region\": \"US\",\n  \"export_format\": \"zoho\",\n  \"records\": [\n    {\n      \"first_name\": \"Jane\",\n      \"last_name\": \"Doe\",\n      \"email\": \"jane@example.com\",\n      \"phone\": \"+12025550100\",\n      \"company\": \"Acme Inc\",\n      \"city\": \"Austin\",\n      \"state\": \"TX\",\n      \"zip\": \"78701\"\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/v1/clean"
      }
    },
    {
      "name": "CSV upload (multipart)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Attach a UTF-8 CSV with header row, e.g. email,first_name,company"
            },
            { "key": "default_phone_region", "value": "US", "type": "text" },
            { "key": "export_format", "value": "generic", "type": "text" }
          ]
        },
        "url": "{{baseUrl}}/v1/clean/csv"
      }
    },
    {
      "name": "Invalid API key",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "invalid_key_not_in_CRM_API_KEYS" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"records\": []\n}"
        },
        "url": "{{baseUrl}}/v1/clean"
      }
    },
    {
      "name": "Rate limited (free tier — run repeatedly)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{freeTierKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"records\": [{ \"first_name\": \"A\", \"last_name\": \"B\", \"email\": \"a@b.co\", \"company\": \"C\" }]\n}"
        },
        "description": "Set collection variable `freeTierKey` to a **free** tier key. Send this request **6+ times within 60 seconds** to get HTTP **429** with `error.code` `RATE_LIMITED_MINUTE`.",
        "url": "{{baseUrl}}/v1/clean"
      }
    },
