# Copy to .env and adjust:  cp .env.example .env
# Local dev: ./scripts/dev.sh   or   uvicorn app.main:app --reload --env-file .env

# --- Required (production & local API testing) ---
CRM_AUTH_DISABLED=false
CRM_API_KEYS=sk_free_test:free

# Optional: additional tiers (comma-separated key:tier)
# CRM_API_KEYS=sk_free_test:free,sk_starter_yourkey:starter,sk_growth_yourkey:growth,sk_pro_yourkey:pro

# --- Recommended ---
CRM_USAGE_LOG_PATH=logs/usage.jsonl
CRM_MAX_JSON_BYTES=10485760
CRM_MAX_CSV_BYTES=5242880

# --- Optional diagnostics (unhandled errors) ---
# CRM_DIAGNOSTICS_SECRET=make_a_long_random_secret
# CRM_DIAGNOSTICS_OPENAPI=true
# CRM_ERROR_LOG_PATH=logs/errors.jsonl

# --- RapidAPI hosting only ---
# RAPIDAPI_PROXY_SECRET=
